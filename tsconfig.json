{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2022"], "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "allowImportingTsExtensions": true, "noEmit": true,
    "types": ["node"]
  },
  "include": ["main.ts", "src/**/*.ts", "tests/**/*.ts"]
}
